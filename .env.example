# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Multi-API Key Pool (comma-separated, semicolons, or newlines)
# Enables automatic key rotation on 429 quota exhaustion with cooldown protection.
GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional: Cloud SQL PostgreSQL configuration
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Optional: YouTube & External AI Provider configuration
YOUTUBE_API_KEY=""
EXTERNAL_API_ENABLED="false"
EXTERNAL_API_KEY=""
EXTERNAL_BASE_URL="https://api.openai.com/v1"
EXTERNAL_MODEL="gpt-4o-mini"

